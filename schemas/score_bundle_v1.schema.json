{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tricompose.score_bundle.v1",
  "title": "TriCompose score bundle v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "producer",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "tricompose.score_bundle.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/score_record"
      }
    }
  },
  "$defs": {
    "score_record": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "metric",
        "scope",
        "candidate_ids",
        "value",
        "higher_is_better"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "report_reference",
            "report_pair",
            "cxr_report"
          ]
        },
        "candidate_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        },
        "value": {
          "type": "number"
        },
        "higher_is_better": {
          "type": "boolean"
        }
      }
    }
  }
}
